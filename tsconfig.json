{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "node",
      "@testing-library/jest-dom"
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    ".next-e2e/types/**/*.ts",
    ".next-e2e/dev/types/**/*.ts",
    ".next-e2e-probe/types/**/*.ts",
    ".next-e2e-probe/dev/types/**/*.ts",
    ".next-load/types/**/*.ts",
    ".next-load/dev/types/**/*.ts",
    ".next-bench/types/**/*.ts",
    ".next-bench/dev/types/**/*.ts",
    ".next-tune/types/**/*.ts",
    ".next-tune/dev/types/**/*.ts",
    ".next-e2e-l1/types/**/*.ts",
    ".next-e2e-l1/dev/types/**/*.ts",
    ".next-e2e-l2/types/**/*.ts",
    ".next-e2e-l2/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "artifacts"
  ]
}
