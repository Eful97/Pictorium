# Pictorium — esempio configurazione env (copia in .env.local)
# Vedi docs/CONFIGURATION.md e docs/INTEGRATION.md per dettagli completi.
#
# Il prefisso canonico è PICTORIUM_*. Le vecchie POSTERIUM_* restano accettate
# come fallback (con warning di deprecazione) per non rompere deploy esistenti.

# === Chiavi API (priorità: header x-api-key > query api_key > namespace ?u= > store d'istanza > env) ===
# In alternativa alle env, salva le chiavi dalla UI (Impostazioni → Chiavi API): finiscono in uno
# store d'istanza dedicato e CIFRATO a riposo (KV `instance:keys` o DATA_DIR/instance/keys.json, 0600,
# cifratura AES-256-GCM; con PROFILE_ENCRYPTION_KEY se presente, altrimenti una chiave generata e
# persistita in DATA_DIR/instance/enc.key). Stremio anonimo le risolve senza env; le richieste `?u=`
# multi-utente NON le vedono (mai open-proxy sulla chiave dell'operatore).
# Env fallback opt-in per deploy personali single-user (NON usare su istanze pubbliche multi-utente):
# PICTORIUM_TMDB_KEY=your_tmdb_v3_key
# PICTORIUM_MDBLIST_KEY=your_mdblist_key
# PICTORIUM_TVDB_API_KEY=your_tvdb_key
# PICTORIUM_FANART_KEY=your_fanart_project_key   # poster verticali Fanart.tv (sezione editor); senza, la sezione spiega che non è configurato

# === Trakt (liste pubbliche + OAuth PKCE per watchlist/liste standard private, multi-user) ===
# PICTORIUM_TRAKT_CLIENT_ID=your_trakt_client_id   # liste pubbliche come cataloghi custom (solo lettura, niente OAuth) + OAuth PKCE (stesso app: niente secret)
# NESSUN client secret: le app Trakt nuove usano PKCE ("Client Secret Not issued") — non impostare PICTORIUM_TRAKT_CLIENT_SECRET (se presente viene ignorato).
# Se hai copiato questa riga da una versione precedente, rimuovila:
# ~~PICTORIUM_TRAKT_CLIENT_SECRET=your_trakt_client_secret~~   # RIMOSSO: PKCE non usa secret (inviarlo romperebbe il sign-in)
# PICTORIUM_TRAKT_REDIRECT_URI=https://your-instance/api/trakt/callback   # URI esatta registrata nella dashboard dell'app Trakt (path sempre /api/trakt/callback, SOLO https)
# Test locali via tunnel HTTPS che serve l'intera origine UI (es. https://<tuo-sottodominio>.duckdns.org/api/trakt/callback): niente http://localhost — Trakt richiede redirect https.

# === Storage ===
# Redis nativo (TCP) per HA multi-replica senza /data — vince su Upstash REST se entrambi settati:
# PICTORIUM_REDIS_URL=redis://:password@redis-master:6379/0
# (su ElfHosted/K8s basta REDIS_URL: è letto come fallback nudo)
# Upstash Redis via REST (serverless). Nomi canonici:
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx
# Nomi legacy di Vercel KV: STESSE credenziali Upstash, accettati come fallback
# con warning di deprecazione (UPSTASH_REDIS_REST_* vince se entrambi presenti).
# KV_REST_API_URL=https://xxx.upstash.io
# KV_REST_API_TOKEN=xxx
# PICTORIUM_KV_CACHE=0   # cache risposte solo in memoria, stato sempre su KV (istanze pubbliche; sconsigliato su serverless)
# PICTORIUM_DATA_DIR=/data

# === Render pipeline ===
# PICTORIUM_MAX_CONCURRENT_RENDERS=4
# PICTORIUM_RENDER_SLOT_WAIT_MS=15000
# PICTORIUM_RENDER_TIMEOUT_MS=30000
# PICTORIUM_CACHE_MAX_MB=150
# PICTORIUM_CACHE_MAX=4000

# === Auth & rate limit ===
# PICTORIUM_ADMIN_TOKEN=supersegreto   # istanze private: incollalo in Impostazioni → Token admin (solo sessione) per usare warmup/cache/save dalla UI. Senza token l'editor è chiuso (fail-closed): la vecchia PICTORIUM_PUBLIC_INSTANCE è stata rimossa e viene ignorata
# PICTORIUM_ALLOW_DEV_ADMIN=1   # solo in dev: apre admin ovunque (default: solo loopback)
# PICTORIUM_WARMUP_TOKEN=warmup-segreto
# PICTORIUM_RATELIMIT_POSTER_MAX=200
# PICTORIUM_LOG_LEVEL=info
# PICTORIUM_LOG_FORMAT=human
# PICTORIUM_ALLOWED_HOSTS=example.com

# === Proxy addon & IP client (hardening per istanze condivise) ===
# PICTORIUM_TRUST_PROXY=1   # SOLO dietro un reverse proxy/Cloudflare che SOVRASCRIVE gli header: abilita x-real-ip/cf-connecting-ip/x-forwarded-for per il rate-limit. Senza proxy questi header sono falsificabili e il limite diventa aggirabile (default: nessun header, bucket condiviso "local")
# PICTORIUM_CLIENT_IP_HEADER=cf-connecting-ip   # con TRUST_PROXY=1: IP client SOLO da questo header (valore singolo sovrascritto dal proxy, non X-Forwarded-For)
# PICTORIUM_PROXY_ALLOW_DOMAINS=example.com,addons.example.org   # allowlist host del proxy addon (+ sottodomini). SEMPRE consigliata su istanze pubbliche: senza lista le richieste anonime sono rifiutate (default-deny su MULTI_USER=1/HOSTED_BY=elfhosted; le istanze private self-hosted restano open legacy)
# PICTORIUM_PROXY_ALLOW_ANY=1   # RISCHIOSO, NON usare su istanze pubbliche: riapre il proxy addon a QUALSIASI host pubblico (open relay / SSRF-by-proxy per chiunque). Serve solo a un operatore privato consapevole; preferisci PROXY_ALLOW_DOMAINS

# === Config token & profili ===
# PICTORIUM_MULTI_USER=1   # home = gate profili stile AIO (crea/seleziona spazio UUID); il primo spazio eredita mapping+default globali
# PICTORIUM_MAX_USERS=500   # cap anti-Sybil sul numero di spazi (0 o assente = illimitati)
# PICTORIUM_PUBLIC_STATS=0   # conteggi utenti di /api/status solo per admin (default: pubblici)
# PICTORIUM_MAX_MAPPINGS_PER_USER=500   # quota poster personalizzati per spazio (default: 500)
# CONFIG_HMAC_SECRET=segreto-firma-token   # senza, i ?config= non sono firmati (fail-closed in prod)
# PROFILE_ENCRYPTION_KEY=chiave-32-byte-hex   # senza, le chiavi profilo restano in chiaro (warning in prod)

# === Region & warmup ===
# PICTORIUM_REGION=IT
# PICTORIUM_SELF_WARMUP=1

# === Sponsor / hosting pubblico ===
# PICTORIUM_HOSTED_BY=elfhosted   # mostra il banner sponsor (solo "elfhosted" attivo, vuoto = nessun banner)

# === Avviso chiusura istanza DuckDNS (una tantum) ===
# PICTORIUM_DUCKDNS_NOTICE=1   # banner dismissible in cima all'app: solo per questa istanza (gate su env, nessun rilevamento hostname). NEXT_PUBLIC_DUCKDNS_NOTICE accettata come alias; assente o altro valore = nessun markup

# === Custom Rating Provider ===
# Endpoint e header anche dall'editor (vince sull'env); la chiave SOLO env.
# PICTORIUM_CUSTOM_RATING_ENABLED=1
# PICTORIUM_CUSTOM_RATING_ENDPOINT=https://example.com/ratings/{imdbId}
# PICTORIUM_CUSTOM_RATING_API_KEY=segreto-provider
# PICTORIUM_CUSTOM_RATING_API_KEY_HEADER=X-API-Key
# PICTORIUM_CUSTOM_RATINGS=1   # default display riga (overridabile per-titolo)

# === Docker (solo compose) ===
# PICTORIUM_BIND_IP=127.0.0.1   # bind host (default 0.0.0.0)
# PICTORIUM_HOST_PORT=8080      # porta host (interna resta 8080)

# === Sharp & build ===
# SHARP_CONCURRENCY=2
# SHARP_CACHE_MEMORY_MB=64
# NODE_MAX_OLD_SPACE=384
